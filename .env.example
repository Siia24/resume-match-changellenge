# Ключ авторизации из кабинета GigaChat: готовая Base64-строка Authorization key.
# Настоящий ключ сюда не пишите и в репозиторий не кладите.
GIGACHAT_AUTH_KEY=

# Версия доступа. Для физлица на бесплатном тарифе — GIGACHAT_API_PERS.
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Необязательно. Базовый адрес API. Если пусто — https://api.giga.chat/v1
# К нему добавляется /chat/completions. Можно указать и полный адрес метода.
# GIGACHAT_API_URL=https://api.giga.chat/v1

# Необязательно. Id модели из кабинета. Если пусто — GigaChat-2.
# Старое имя GigaChat на текущем API отвечает 404.
GIGACHAT_MODEL=GigaChat-2

# Необязательно. Номер счётчика Яндекс Метрики. Если пусто, счётчик не грузится.
NEXT_PUBLIC_YM_ID=
